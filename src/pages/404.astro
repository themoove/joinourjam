---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found — CITY JAM"
  description="That page is not on the record."
  path="/404"
  noindex
>
  <header class="hero">
    <div class="wrap narrow">
      <p class="kick"><span class="dot"></span> 404</p>
      <h1>That page is not on the record.</h1>
      <p class="lede">The address doesn’t match anything we publish. The magazine does. So does the front door.</p>
      <div class="acts">
        <a class="btn solid lg" href="/">Back to the room</a>
        <a class="btn ghost lg" href="/magazine">Read the magazine</a>
      </div>
    </div>
  </header>
</Base>
