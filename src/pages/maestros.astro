---
import Base from '../layouts/Base.astro';
import Funnel from '../components/Funnel.astro';
import Next from '../components/Next.astro';
import Vinyl from '../components/Vinyl.astro';
import { resolveFunnel } from '../lib/funnels';

const wait = resolveFunnel('maestroWaitlist', 'maestros', 'closer');
---
<Base
  title="Maestro classes — CITY JAM"
  description="Recorded classes with working musicians. Stevie DeAcutis and Lindy Day."
  path="/maestros"
  closerHref={wait.href}
  closerLabel="Join the waitlist"
  closerExternal={wait.external}
>
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kick"><span class="dot"></span> Maestro · waitlist</p>
        <h1>Learn from people who still do the work.</h1>
        <p class="lede">Recorded classes with working musicians. Stevie DeAcutis teaches <b>LIFE IN MUSIC</b>. Lindy Day teaches <b>UNSTUCK: FIND YOUR SOUND</b>. The questions, and the match, happen on the waitlist.</p>
        <p class="pill">Waitlist open now. Details coming soon.</p>
        <div class="acts">
          <Funnel funnel="maestroWaitlist" campaign="maestros" content="join-the-waitlist">Join the waitlist</Funnel>
        </div>
        <p class="fine">This waitlist is for students. If you want to teach, <a href="/teach">apply as a maestro</a>.</p>
      </div>
      <Vinyl label="MAESTRO" />
    </div>
  </header>

  <section>
    <div class="wrap cards c2">
      <article class="card">
        <div class="k">Stevie DeAcutis</div>
        <h3>LIFE IN MUSIC</h3>
        <p>Producer, mixer and engineer. He runs Sound Spa in Edison, New Jersey. Four decades of listening, in his own voice. A class has not launched, and this page does not name a price.</p>
      </article>
      <article class="card">
        <div class="k">Lindy Day</div>
        <h3>UNSTUCK: FIND YOUR SOUND</h3>
        <p>Guitarist, educator, performer and composer. The class is for players who already know some of the instrument. The price is not on this page.</p>
      </article>
    </div>
  </section>

  <section class="slab">
    <div class="wrap narrow prose">
      <p class="kick"><span class="dot"></span> A separate programme</p>
      <h2>Creator Labs is not a class.</h2>
      <p class="lead">Creator Labs starts with the community, then courses with lifetime access, then tiers. A Maestro class is not a place in that cohort, and the cohort is not a class. No prices are printed here.</p>
      <div class="acts">
        <Funnel funnel="maestroWaitlist" campaign="maestros" content="find-your-course">Find your course</Funnel>
        <a class="btn ghost" href="/labs">See Creator Labs</a>
      </div>
    </div>
  </section>
  <Next items={[
    { href: '/teach', label: 'Teach', note: 'The application for maestros, not students.' },
    { href: '/learn', label: 'Learn', note: 'Where to start, before a class exists.' },
    { href: '/workbook', label: 'Part Zero', note: 'Five chapters, free, on the page.' },
  ]} />
</Base>
