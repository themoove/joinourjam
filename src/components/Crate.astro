---
import { desks } from '../data/desks';
---
<div class="crate">
  <div class="crnav">
    <button class="crbtn" type="button" data-dir="-1" aria-label="Previous desks">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="crbtn" type="button" data-dir="1" aria-label="Next desks">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
  <div class="cratescroll" data-crate tabindex="0">
    {desks.map((desk, i) => (
      <div class="slot">
        <div class:list={['cdisc', i % 3 === 0 && 'spin']} aria-hidden="true">
          <span class="turn"><span class="vface"></span><span class="vlabel">CJ</span></span>
        </div>
        <a class="sleeve" href="/desks" aria-label={desk.name}>
          <img src={`/assets/desk-${desk.key}.jpg`} alt="" />
        </a>
      </div>
    ))}
  </div>
</div>
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-crate]').forEach((scroller) => {
    const root = scroller.parentElement;
    if (!root) return;
    root.querySelectorAll('[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir')) || 1;
        scroller.scrollBy({ left: dir * 280, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
    let active = false;
    let startX = 0;
    let origin = 0;
    scroller.addEventListener('pointerdown', (event) => {
      if (!(event instanceof PointerEvent)) return;
      if ((event.target as Element | null)?.closest('a, button')) return;
      active = true;
      startX = event.clientX;
      origin = scroller.scrollLeft;
      scroller.classList.add('drag');
    });
    scroller.addEventListener('pointermove', (event) => {
      if (!active || !(event instanceof PointerEvent)) return;
      scroller.scrollLeft = origin - (event.clientX - startX);
    });
    const end = () => {
      active = false;
      scroller.classList.remove('drag');
    };
    scroller.addEventListener('pointerup', end);
    scroller.addEventListener('pointercancel', end);
  });
</script>
