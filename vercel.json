{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/rebels-and-legends/tour", "destination": "/rebels-and-legends/tour/index.html" },
    { "source": "/rebels-and-legends/tour/", "destination": "/rebels-and-legends/tour/index.html" },
    { "source": "/((?!sitemap.xml|robots.txt|og.jpg|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
